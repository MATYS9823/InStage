<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #9E9E9E; -fx-padding: 10;">
            <children>
                <Button style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="40.0" preserveRatio="true">
                            <image>
                                <Image url="@logo.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Button style="-fx-background-color: #757575; -fx-background-radius: 50; -fx-min-width: 40; -fx-min-height: 40; -fx-text-fill: white; -fx-cursor: hand;" text="👤">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <VBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Mot de passe oublié" textFill="#9a9a9a">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>

                <VBox maxWidth="400.0" spacing="15.0">
                    <children>
                        <Label text="E-MAIL" textFill="#9a9a9a">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="forgotEmailTextField" promptText="bonjour@canva.com" style="-fx-background-color: #EEEEEE; -fx-background-radius: 10; -fx-padding: 10;" />
                    </children>
                </VBox>

                <VBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="resetPasswordButton" prefWidth="250.0" style="-fx-background-color: #333333; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 12; -fx-cursor: hand;" text="Envoyer le lien de réinitialisation">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Hyperlink onAction="#connexionMenuItemAction" text="Retour à la page de connexion" textFill="#9a9a9a" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>