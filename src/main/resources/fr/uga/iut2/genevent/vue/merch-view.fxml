<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <BorderPane style="-fx-background-color: #F4F4F4;">

        <top>
            <VBox>
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: #909090; -fx-padding: 10 20 10 20;">
                    <Button style="-fx-background-color: white; -fx-text-fill: black; -fx-background-radius: 3; -fx-padding: 5 30 5 30;" text="Logo" />
                    <Region HBox.hgrow="ALWAYS" />
                    <StackPane prefHeight="35.0" prefWidth="35.0" style="-fx-border-color: white; -fx-border-width: 1.5; -fx-border-radius: 50%; -fx-padding: 5;">
                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
                    </StackPane>
                </HBox>

                <BorderPane style="-fx-padding: 10 20 10 20; -fx-background-color: transparent;">
                    <left>
                        <Label onMouseClicked="#toggleMenuMerch" style="-fx-font-size: 32px; -fx-text-fill: #555555; -fx-font-weight: bold; -fx-cursor: hand;" text="☰" BorderPane.alignment="CENTER" />
                    </left>
                </BorderPane>
            </VBox>
        </top>

        <center>
            <VBox alignment="TOP_CENTER" spacing="15.0" style="-fx-padding: 0 40 20 40;">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: black;" text="Gestion des produits dérivés" />
                <Separator prefWidth="200.0" style="-fx-background-color: #D0D0D0;" />

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-control-inner-background: transparent; -fx-border-color: transparent;">
                    <VBox alignment="TOP_CENTER" spacing="30.0" style="-fx-padding: 20;">

                        <VBox maxWidth="700" spacing="20.0" style="-fx-background-color: #B3B3B3; -fx-background-radius: 15; -fx-padding: 20;">
                            <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 20px; -fx-text-fill: #333333;" text="Nom_merch" />

                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #333333;" text="Produit :" />
                                <Label style="-fx-background-color: #F0F0F0; -fx-background-radius: 15; -fx-padding: 5 15; -fx-text-fill: #333333;" text="Tee-shirt" />
                                <Label style="-fx-background-color: #F0F0F0; -fx-background-radius: 15; -fx-padding: 5 15; -fx-text-fill: #333333;" text="Goodies" />
                                <Label style="-fx-background-color: #F0F0F0; -fx-background-radius: 15; -fx-padding: 5 25; -fx-text-fill: transparent;" text="---" />
                                <Label style="-fx-background-color: #F0F0F0; -fx-background-radius: 15; -fx-padding: 5 25; -fx-text-fill: transparent;" text="---" />
                            </HBox>

                            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                <Button style="-fx-background-color: #E0E0E0; -fx-text-fill: black; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="Modifier ✍" />
                                <Button onAction="#supprimerMerchAction" style="-fx-background-color: #8C8C8C; -fx-text-fill: black; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="Supprimer 🗑" />
                            </HBox>
                        </VBox>

                        <VBox maxWidth="700" spacing="20.0" style="-fx-background-color: #B3B3B3; -fx-background-radius: 15; -fx-padding: 20;">
                            <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 20px; -fx-text-fill: #333333;" text="Nom_merch" />

                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #333333;" text="Produit :" />
                                <Label style="-fx-background-color: #F0F0F0; -fx-background-radius: 15; -fx-padding: 5 15; -fx-text-fill: #333333;" text="Pull" />
                                <Label style="-fx-background-color: #F0F0F0; -fx-background-radius: 15; -fx-padding: 5 25; -fx-text-fill: transparent;" text="---" />
                                <Label style="-fx-background-color: #F0F0F0; -fx-background-radius: 15; -fx-padding: 5 25; -fx-text-fill: transparent;" text="---" />
                                <Label style="-fx-background-color: #F0F0F0; -fx-background-radius: 15; -fx-padding: 5 25; -fx-text-fill: transparent;" text="---" />
                            </HBox>

                            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                <Button style="-fx-background-color: #E0E0E0; -fx-text-fill: black; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="Modifier ✍" />
                                <Button onAction="#supprimerMerchAction" style="-fx-background-color: #8C8C8C; -fx-text-fill: black; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="Supprimer 🗑" />
                            </HBox>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </VBox>
        </center>

        <bottom>
            <HBox alignment="BOTTOM_RIGHT" style="-fx-padding: 0 40 40 0;">
                <Button onAction="#ajouterMerchAction" style="-fx-background-color: #A9A9A9; -fx-text-fill: black; -fx-font-size: 14px; -fx-background-radius: 20; -fx-padding: 10 25; -fx-cursor: hand;" text="Ajout merch  +" />
            </HBox>
        </bottom>

    </BorderPane>

    <Region fx:id="scrimMerch" onMouseClicked="#toggleMenuMerch" style="-fx-background-color: rgba(0,0,0,0.4);" visible="false" />

    <VBox fx:id="sideMenuMerch" maxWidth="250.0" style="-fx-background-color: #555555;" visible="false" StackPane.alignment="CENTER_LEFT">

        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 15 20 20 20;">
            <Label onMouseClicked="#toggleMenuMerch" style="-fx-font-size: 28px; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="×" />
        </HBox>

        <VBox spacing="15.0" style="-fx-padding: 10 0 20 0;">
            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 10 20 10 30; -fx-cursor: hand;">
                <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="🏠 Vos concerts" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 10 20 10 30; -fx-cursor: hand;">
                <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="🍸 Buvette" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 0 25 25 0; -fx-padding: 10 20 10 30; -fx-cursor: hand;">
                <Label style="-fx-text-fill: black; -fx-font-size: 16px; -fx-font-weight: bold;" text="📊 Merch" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 10 20 10 30; -fx-cursor: hand;">
                <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="👤 Staff" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 10 20 10 30; -fx-cursor: hand;">
                <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="📦 Matériel" />
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS" /> <VBox alignment="CENTER" style="-fx-padding: 20;">
        <Button style="-fx-background-color: white; -fx-text-fill: black; -fx-background-radius: 20; -fx-padding: 10 20;" text="Goosebump_France" />
    </VBox>
    </VBox>

</StackPane>
