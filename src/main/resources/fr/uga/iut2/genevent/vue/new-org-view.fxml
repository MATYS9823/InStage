<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #9E9E9E; -fx-padding: 10;">
            <children>
                <Button style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="40.0" preserveRatio="true">
                            <image>
                                <Image url="@logo.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#connexionMenuItemAction" style="-fx-background-color: #757575; -fx-background-radius: 50; -fx-min-width: 40; -fx-min-height: 40; -fx-text-fill: white; -fx-cursor: hand;" text="👤">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <VBox alignment="CENTER" spacing="25.0" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Créer un nouveau compte" textFill="#9a9a9a">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>

                <VBox maxWidth="400.0" spacing="12.0">
                    <children>
                        <Label text="PRÉNOM" textFill="#9a9a9a" />
                        <TextField fx:id="newOrgForenameTextField" onKeyReleased="#validateOrgTextFields" promptText="Julie" style="-fx-background-color: #EEEEEE; -fx-background-radius: 10; -fx-padding: 10;" />

                        <Label text="NOM" textFill="#9a9a9a" />
                        <TextField fx:id="newOrgSurnameTextField" onKeyReleased="#validateOrgTextFields" promptText="Marnier" style="-fx-background-color: #EEEEEE; -fx-background-radius: 10; -fx-padding: 10;" />

                        <Label text="E-MAIL" textFill="#9a9a9a" />
                        <TextField fx:id="newOrgEmailTextField" onKeyReleased="#validateOrgTextFields" promptText="bonjour@canva.com" style="-fx-background-color: #EEEEEE; -fx-background-radius: 10; -fx-padding: 10;" />

                        <Label text="MOT DE PASSE" textFill="#9a9a9a" />
                        <PasswordField fx:id="newOrgMdpTextField" onKeyReleased="#validateOrgTextFields" promptText="••••••" style="-fx-background-color: #EEEEEE; -fx-background-radius: 10; -fx-padding: 10;" />
                    </children>
                </VBox>

                <VBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="newOrgOkButton" disable="true" onAction="#createNewOrganisateurAction" prefWidth="200.0" style="-fx-background-color: #333333; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 12; -fx-cursor: hand;" text="S'inscrire">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Hyperlink fx:id="inscritlink" onAction="#connexionMenuItemAction" text="Vous êtes déjà inscrit ? Se connecter" textFill="#9a9a9a" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>
