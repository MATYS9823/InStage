<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox alignment="TOP_CENTER" prefHeight="720.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="75.0" styleClass="header">
            <children>
                <Button onAction="#allerVersAccueil" styleClass="icon-button">
                    <graphic>
                        <ImageView fitHeight="45.0" preserveRatio="true">
                            <image><Image url="@logotransparent.png" /></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <MenuButton styleClass="icon-button">
                    <graphic>
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" fill="white" scaleX="1.3" scaleY="1.3" />
                    </graphic>
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#connexionMenuItemAction" text="Se déconnecter" />
                        <MenuItem mnemonicParsing="false" onAction="#quitterMenuBurgerAction" text="Quitter" />
                    </items>
                </MenuButton>
            </children>
        </HBox>

        <StackPane VBox.vgrow="ALWAYS">
            <children>
                <BorderPane style="-fx-background-color: transparent;">
                    <top>
                        <VBox>
                            <children>
                                <BorderPane style="-fx-padding: 10 20 10 20;">
                                    <left>
                                        <Label onMouseClicked="#toggleMenuD" style="-fx-font-size: 32px; -fx-text-fill: #B0B0B0; -fx-font-weight: bold; -fx-cursor: hand;" text="☰" BorderPane.alignment="CENTER" />
                                    </left>

                                    <center>
                                        <HBox alignment="CENTER_LEFT" spacing="15.0" BorderPane.alignment="CENTER">
                                            <BorderPane.margin>
                                                <Insets left="30.0" />
                                            </BorderPane.margin>
                                            <children>
                                                <Label fx:id="dashboardConcertLabel" styleClass="text-dark" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Goosebump_France" />
                                                <Label fx:id="dashboardDateLabel" style="-fx-font-size: 14px; -fx-text-fill: #555555; -fx-font-style: italic;" text="📅 --" />
                                                <Button onAction="#allerVersCoutsDepuisDashboard" style="-fx-background-color: #1C1C1E; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 4 12; -fx-font-size: 12px;" text="Coûts &amp; Opti 📊" />
                                            </children>
                                        </HBox>
                                    </center>

                                    <right>
                                        <Label fx:id="dashboardArtisteLabel" styleClass="text-dark" style="-fx-font-size: 24px;" text="Travis Scott" BorderPane.alignment="CENTER" />
                                    </right>
                                </BorderPane>
                                <Separator style="-fx-background-color: #D0D0D0;" />
                            </children>
                        </VBox>
                    </top>
                    <center>
                        <GridPane alignment="CENTER" hgap="60.0" vgap="40.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="350.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="350.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="220.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="220.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <VBox alignment="TOP_CENTER" spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <children>
                                        <Label styleClass="text-dark" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Ma buvette" />
                                        <VBox alignment="CENTER" prefHeight="180.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #000000; -fx-border-width: 2; -fx-border-radius: 20; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);">
                                            <children>
                                                <Label fx:id="dashboardBuvetteNomLabel" styleClass="text-dark" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Utopia" />
                                                <Label fx:id="dashboardBuvetteThemeLabel" styleClass="text-dark" style="-fx-font-size: 14px; -fx-font-style: italic;" text="Localisation: Sud" />
                                                <Button onAction="#allerVersBuvette" styleClass="custom-button" style="-fx-padding: 8 25 8 25;" text="Voir plus" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox alignment="TOP_CENTER" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <children>
                                        <Label styleClass="text-dark" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Merchandising" />
                                        <VBox alignment="CENTER" prefHeight="180.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #000000; -fx-border-width: 2; -fx-border-radius: 20; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);">
                                            <children>
                                                <Label fx:id="dashboardMerchNomLabel" styleClass="text-dark" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Utopia_store" />
                                                <Button onAction="#allerVersMerch" styleClass="custom-button" style="-fx-padding: 8 20 8 20;" text="Voir les produits" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox alignment="TOP_CENTER" spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <children>
                                        <Label styleClass="text-dark" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Personnel" />
                                        <VBox alignment="CENTER" prefHeight="180.0" spacing="5.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #000000; -fx-border-width: 2; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);">
                                            <children>
                                                <Label fx:id="dashboardStaffCountLabel" styleClass="text-dark" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Nombre d'équipe: 5" />
                                                <Label styleClass="text-dark" style="-fx-font-size: 14px;" text="Catégories:" />
                                                <Label fx:id="dashboardStaffCategoriesLabel" styleClass="text-dark" style="-fx-font-size: 14px; -fx-font-style: italic;" text="Sécurité,Buvette,Merch" />
                                                <Button onMouseClicked="#allerVersStaff" styleClass="custom-button" style="-fx-padding: 8 25 8 25;">
                                                    <VBox.margin><Insets top="15.0" /></VBox.margin>
                                                    <text>Voir les équipes</text>
                                                </Button>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox alignment="TOP_CENTER" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <children>
                                        <Label styleClass="text-dark" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Matériel" />
                                        <VBox alignment="CENTER" prefHeight="180.0" spacing="5.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #000000; -fx-border-width: 2; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);">
                                            <children>
                                                <Label styleClass="text-dark" style="-fx-font-size: 14px;" text="Catégories:" />
                                                <Label fx:id="dashboardMaterielCategoriesLabel" styleClass="text-dark" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-font-style: italic;" text="Son,Lumière,Sécurité" />
                                                <Button onAction="#allerVersMateriel" styleClass="custom-button" style="-fx-padding: 8 15 8 15;">
                                                    <VBox.margin><Insets top="15.0" /></VBox.margin>
                                                    <text>Voir la liste logistique</text>
                                                </Button>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </GridPane>
                    </center>
                </BorderPane>

                <Region fx:id="scrim" onMouseClicked="#toggleMenuD" style="-fx-background-color: rgba(0,0,0,0.4);" visible="false" />

                <VBox fx:id="sideMenuD" maxWidth="300.0" styleClass="sidebar" visible="false" StackPane.alignment="CENTER_LEFT">
                    <children>
                        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 15 20 20 20;">
                            <children>
                                <Label onMouseClicked="#toggleMenuD" style="-fx-font-size: 28px; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="×" />
                            </children>
                        </HBox>

                        <VBox spacing="20.0" style="-fx-padding: 20 20 20 40;">
                            <children>
                                <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersAccueil" spacing="15.0" style="-fx-cursor: hand;">
                                    <children>
                                        <SVGPath content="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
                                        <Label style="-fx-text-fill: white; -fx-font-size: 18px;" text="Accueil" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersRechercheSalles" spacing="15.0" style="-fx-cursor: hand;">
                                    <children>
                                        <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
                                        <Label style="-fx-text-fill: white; -fx-font-size: 18px;" text="Rechercher une salle" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersMesConcerts" spacing="15.0" style="-fx-cursor: hand;">
                                    <children>
                                        <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
                                        <Label style="-fx-text-fill: white; -fx-font-size: 18px;" text="Mes concerts" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</VBox>