<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: white;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: #909090; -fx-padding: 10 20 10 20;">
            <Button style="-fx-background-color: white; -fx-text-fill: black; -fx-background-radius: 3; -fx-padding: 5 30 5 30;" text="Logo" />
            <Region HBox.hgrow="ALWAYS" />
            <MenuButton style="-fx-background-color: transparent; -fx-cursor: hand;">
                <graphic>
                    <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" fill="white" scaleX="1.3" scaleY="1.3" />
                </graphic>
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#connexionMenuItemAction" text="Se déconnecter" />
                    <MenuItem mnemonicParsing="false" onAction="#quitterMenuBurgerAction" text="Quitter" />
                </items>
            </MenuButton>
        </HBox>
    </top>

    <center>
        <StackPane>

            <BorderPane style="-fx-background-color: white;">
                <top>
                    <VBox>
                        <BorderPane style="-fx-padding: 10 20 10 20; -fx-background-color: white;">
                            <left>
                                <Label onMouseClicked="#toggleMenuD" style="-fx-font-size: 32px; -fx-text-fill: #B0B0B0; -fx-font-weight: bold; -fx-cursor: hand;" text="☰" BorderPane.alignment="CENTER" />
                            </left>
                            <center>
                                <Label fx:id="dashboardConcertLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #000000;" text="Goosebump_France" BorderPane.alignment="CENTER" />
                            </center>
                            <right>
                                <Label fx:id="dashboardArtisteLabel" style="-fx-font-size: 24px; -fx-text-fill: #000000;" text="Travis Scott" BorderPane.alignment="CENTER" />
                            </right>
                        </BorderPane>
                        <Separator prefWidth="200.0" style="-fx-background-color: #D0D0D0;" />
                    </VBox>
                </top>
                <center>
                    <GridPane alignment="CENTER" hgap="60.0" style="-fx-background-color: white;" vgap="40.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="350.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="350.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="220.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="220.0" vgrow="SOMETIMES" />
                        </rowConstraints>

                        <VBox alignment="TOP_CENTER" spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: black;" text="Ma buvette" />
                            <VBox alignment="CENTER" prefHeight="180.0" spacing="15.0" style="-fx-background-color: #D3D3D3; -fx-background-radius: 20;">
                                <Label fx:id="dashboardBuvetteNomLabel" style="-fx-font-size: 18px;" text="Utopia" />
                                <Label fx:id="dashboardBuvetteThemeLabel" style="-fx-font-size: 14px; -fx-font-style: italic;" text="Thème: Amerique" />
                                <Button onAction="#allerVersBuvette" style="-fx-background-color: #AEAEAE; -fx-text-fill: black; -fx-background-radius: 20; -fx-padding: 8 25 8 25; -fx-cursor: hand;" text="Voir plus" />
                            </VBox>
                        </VBox>

                        <VBox alignment="TOP_CENTER" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: black;" text="Merchandising" />
                            <VBox alignment="CENTER" prefHeight="180.0" spacing="15.0" style="-fx-background-color: #D3D3D3; -fx-background-radius: 20;">
                                <Label fx:id="dashboardMerchNomLabel" style="-fx-font-size: 18px;" text="Utopia_store" />
                                <Button onAction="#allerVersMerch" style="-fx-background-color: #AEAEAE; -fx-text-fill: black; -fx-background-radius: 20; -fx-padding: 8 20 8 20; -fx-cursor: hand;" text="Voir les produits" />
                            </VBox>
                        </VBox>

                        <VBox alignment="TOP_CENTER" spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: black;" text="Personnel" />
                            <VBox alignment="CENTER" prefHeight="180.0" spacing="5.0" style="-fx-background-color: #D3D3D3; -fx-background-radius: 20; -fx-padding: 10;">
                                <Label fx:id="dashboardStaffCountLabel" style="-fx-font-size: 16px;" text="Nombre d'équipe: 5" />
                                <Label style="-fx-font-size: 16px;" text="Catégorie:" />
                                <Label fx:id="dashboardStaffCategoriesLabel" style="-fx-font-size: 16px;" text="Sécurité,Buvette,Merch" />
                                <Button onMouseClicked="#allerVersStaff" style="-fx-background-color: #AEAEAE; -fx-text-fill: black; -fx-background-radius: 20; -fx-padding: 8 25 8 25; -fx-cursor: hand;" text="Voir les équipes">
                                    <VBox.margin><Insets top="15.0" /></VBox.margin>
                                </Button>
                            </VBox>
                        </VBox>

                        <VBox alignment="TOP_CENTER" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: black;" text="Matériel" />
                            <VBox alignment="CENTER" prefHeight="180.0" spacing="5.0" style="-fx-background-color: #D3D3D3; -fx-background-radius: 20; -fx-padding: 10;">
                                <Label style="-fx-font-size: 16px;" text="Catégorie:" />
                                <Label fx:id="dashboardMaterielCategoriesLabel" style="-fx-font-size: 16px;" text="Son,Lumière,Sécurité" />
                                <Button onAction="#allerVersMateriel" style="-fx-background-color: #AEAEAE; -fx-text-fill: black; -fx-background-radius: 20; -fx-padding: 8 15 8 15; -fx-cursor: hand;" text="Voir la liste logistique">
                                    <VBox.margin><Insets top="15.0" /></VBox.margin>
                                </Button>
                            </VBox>
                        </VBox>
                    </GridPane>
                </center>
            </BorderPane>

            <Region fx:id="scrim" onMouseClicked="#toggleMenuD" style="-fx-background-color: rgba(0,0,0,0.4);" visible="false" />

            <VBox fx:id="sideMenuD" maxWidth="300.0" style="-fx-background-color: #555555;" visible="false" StackPane.alignment="CENTER_LEFT">
                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 15 20 20 20;">
                    <Label onMouseClicked="#toggleMenuD" style="-fx-font-size: 28px; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="×" />
                </HBox>

                <VBox spacing="20.0" style="-fx-padding: 20 20 20 40;">
                    <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersAccueil" spacing="15.0" style="-fx-cursor: hand;">
                        <SVGPath content="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
                        <Label style="-fx-text-fill: white; -fx-font-size: 18px;" text="Accueil" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersRechercheSalles" spacing="15.0" style="-fx-cursor: hand;">
                        <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
                        <Label style="-fx-text-fill: white; -fx-font-size: 18px;" text="Rechercher une salle" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersMesConcerts" spacing="15.0" style="-fx-cursor: hand;">
                        <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
                        <Label style="-fx-text-fill: white; -fx-font-size: 18px;" text="Mes concerts" />
                    </HBox>
                </VBox>
            </VBox>

        </StackPane>
    </center>

</BorderPane>