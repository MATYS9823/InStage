<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="720.0" prefWidth="1200.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="55.0" style="-fx-background-color: #909090; -fx-padding: 10 20 10 20;">
            <children>
                <Button style="-fx-background-color: white; -fx-text-fill: black; -fx-background-radius: 3; -fx-padding: 5 30 5 30;" text="Logo" />
                <Region HBox.hgrow="ALWAYS" />
                <StackPane prefHeight="35.0" prefWidth="35.0" stylcoe="-fx-border-color: white; -fx-border-width: 1.5; -fx-border-radius: 50%; -fx-padding: 5;">
                    <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
                </StackPane>
            </children>
        </HBox>
    </top>

    <center>
        <StackPane>
            <children>
                <BorderPane style="-fx-background-color: white;">
                    <top>
                        <VBox>
                            <children>
                                <HBox alignment="CENTER_LEFT" style="-fx-padding: 15 20 10 20;">
                                    <children>
                                        <Label onMouseClicked="#toggleMenuD" style="-fx-font-size: 32px; -fx-text-fill: #B0B0B0; -fx-font-weight: bold; -fx-cursor: hand;" text="☰" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: black;" text="Ma buvette" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Region prefWidth="40.0" /> </children>
                                </HBox>
                                <Separator prefWidth="200.0" style="-fx-background-color: #D0D0D0;" />
                            </children>
                        </VBox>
                    </top>
                    <center>
                        <VBox alignment="CENTER" spacing="30.0" BorderPane.alignment="CENTER">
                            <children>
                                <Label text="Vous ne possédez pas de buvette&#10;pour le moment." textAlignment="CENTER" style="-fx-font-size: 24px; -fx-font-style: italic; -fx-text-fill: #A0A0A0;" />
                                <Label text="Si vous conservez ce choix&#10;aucune buvette ne sera présente&#10;pour ce concert" textAlignment="CENTER" style="-fx-font-size: 24px; -fx-font-style: italic; -fx-text-fill: #A0A0A0;" />
                                <Button prefHeight="50.0" prefWidth="180.0" style="-fx-background-color: #C0C0C0; -fx-background-radius: 30; -fx-text-fill: black; -fx-font-size: 18px; -fx-cursor: hand;" text="Créer   ➕" />
                            </children>
                        </VBox>
                    </center>
                </BorderPane>

                <Region fx:id="scrim" onMouseClicked="#toggleMenuD" style="-fx-background-color: rgba(0,0,0,0.4);" visible="false" />

                <VBox fx:id="sideMenuD" maxWidth="280.0" prefWidth="280.0" style="-fx-background-color: #555555;" visible="false" StackPane.alignment="CENTER_LEFT">
                    <children>
                        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 15 20 20 20;">
                            <children>
                                <Label onMouseClicked="#toggleMenuD" style="-fx-font-size: 28px; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="×" />
                            </children>
                        </HBox>

                        <VBox spacing="15.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersMesConcerts" spacing="15.0" style="-fx-padding: 10 20 10 30; -fx-cursor: hand;">
                                    <children>
                                        <Label text="🏠" style="-fx-font-size: 20px; -fx-text-fill: white;" />
                                        <Label text="Vos concerts" style="-fx-font-size: 16px; -fx-text-fill: white;" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 0 30 30 0; -fx-padding: 10 20 10 30; -fx-cursor: hand;">
                                    <children>
                                        <Label text="🍷" style="-fx-font-size: 20px; -fx-text-fill: black;" />
                                        <Label text="Buvette" style="-fx-font-size: 16px; -fx-text-fill: black; -fx-font-weight: bold;" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersMerch" spacing="15.0" style="-fx-padding: 10 20 10 30; -fx-cursor: hand;">
                                    <children>
                                        <Label text="👕" style="-fx-font-size: 20px; -fx-text-fill: white;" />
                                        <Label text="Merch" style="-fx-font-size: 16px; -fx-text-fill: white;" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 10 20 10 30; -fx-cursor: hand;">
                                    <children>
                                        <Label text="👤" style="-fx-font-size: 20px; -fx-text-fill: white;" />
                                        <Label text="Staff" style="-fx-font-size: 16px; -fx-text-fill: white;" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 10 20 10 30; -fx-cursor: hand;">
                                    <children>
                                        <Label text="📦" style="-fx-font-size: 20px; -fx-text-fill: white;" />
                                        <Label text="Matériel" style="-fx-font-size: 16px; -fx-text-fill: white;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <VBox alignment="CENTER" style="-fx-padding: 20;">
                            <children>
                                <Button maxWidth="Infinity" style="-fx-background-color: white; -fx-background-radius: 20; -fx-text-fill: black; -fx-padding: 10;" text="Goosebump_France" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>
