<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="75.0" styleClass="header">
            <children>
                <Button onAction="#toggleSidebar" styleClass="icon-button">
                    <graphic>
                        <SVGPath content="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" fill="white" scaleX="1.5" scaleY="1.5" />
                    </graphic>
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </Button>

                <Button onAction="#allerVersAccueil" styleClass="icon-button">
                    <graphic>
                        <ImageView fitHeight="45.0" preserveRatio="true">
                            <image>
                                <Image url="@Logo.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Region HBox.hgrow="ALWAYS" />

                <MenuButton styleClass="icon-button">
                    <graphic>
                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="white" scaleX="1.5" scaleY="1.5" />
                    </graphic>
                    <items>
                        <MenuItem mnemonicParsing="false" text="Se déconnecter" />
                        <MenuItem mnemonicParsing="false" text="Quitter" />
                    </items>
                </MenuButton>
            </children>
        </HBox>
    </top>

    <left>
        <VBox fx:id="sidebar" prefWidth="70.0" spacing="15.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="btnConcerts" contentDisplay="GRAPHIC_ONLY" maxWidth="Infinity" styleClass="sidebar-btn" text="  Vos concerts">
                    <graphic>
                        <SVGPath content="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" scaleX="1.2" scaleY="1.2" />
                    </graphic>
                </Button>

                <Button fx:id="btnBuvette" contentDisplay="GRAPHIC_ONLY" maxWidth="Infinity" styleClass="sidebar-btn-active" text="  Buvette">
                    <graphic>
                        <SVGPath content="M21 5V3H3v2l8 9v5H6v2h12v-2h-5v-5l8-9zM7.43 7L5.66 5h12.69l-1.78 2H7.43z" scaleX="1.2" scaleY="1.2" />
                    </graphic>
                </Button>

                <Button fx:id="btnMerch" contentDisplay="GRAPHIC_ONLY" maxWidth="Infinity" styleClass="sidebar-btn" text="  Merch">
                    <graphic>
                        <SVGPath content="M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z" scaleX="1.2" scaleY="1.2" />
                    </graphic>
                </Button>

                <Button fx:id="btnStaff" contentDisplay="GRAPHIC_ONLY" maxWidth="Infinity" styleClass="sidebar-btn" text="  Staff">
                    <graphic>
                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" scaleX="1.2" scaleY="1.2" />
                    </graphic>
                </Button>

                <Button fx:id="btnMateriel" contentDisplay="GRAPHIC_ONLY" maxWidth="Infinity" styleClass="sidebar-btn" text="  Matériel">
                    <graphic>
                        <SVGPath content="M4 4h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4zM4 10h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4zM4 16h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4z" scaleX="1.2" scaleY="1.2" />
                    </graphic>
                </Button>

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="btnGoosebump" contentDisplay="GRAPHIC_ONLY" maxWidth="Infinity" styleClass="sidebar-btn" text="  Goosebump_France">
                    <graphic>
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" scaleX="1.2" scaleY="1.2" />
                    </graphic>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="40.0" left="60.0" right="60.0" top="40.0" />
            </padding>
            <children>
                <BorderPane>
                    <center>
                        <Label styleClass="text-dark" text="Nom_buvette" BorderPane.alignment="CENTER">
                            <font>
                                <Font name="System Bold" size="36.0" />
                            </font>
                        </Label>
                    </center>
                    <right>
                        <Button styleClass="custom-button" text="Créer une carte ➕" BorderPane.alignment="CENTER">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </right>
                </BorderPane>

                <Separator />

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-control-inner-background: #FFFFFF;">
                    <content>
                        <VBox alignment="TOP_CENTER" spacing="30.0">
                            <padding>
                                <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
                            </padding>
                            <children>

                                <VBox spacing="15.0" styleClass="card-pane">
                                    <children>
                                        <Label alignment="CENTER" maxWidth="Infinity" styleClass="text-dark" text="Carte : &quot;Utopia&quot;">
                                            <font>
                                                <Font name="System Bold" size="22.0" />
                                            </font>
                                        </Label>

                                        <Label styleClass="text-dark" text="Thème : Amerique">
                                            <font>
                                                <Font size="16.0" />
                                            </font>
                                        </Label>

                                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                                            <children>
                                                <Label styleClass="text-dark" text="Produits :">
                                                    <font>
                                                        <Font size="16.0" />
                                                    </font>
                                                </Label>
                                                <HBox spacing="8.0">
                                                    <children>
                                                        <Label styleClass="pill-badge" text="Coca Cola" />
                                                        <Label styleClass="pill-badge" text="Hot-Dog" />
                                                        <Label styleClass="pill-badge" text="Bière" />
                                                        <Label styleClass="pill-badge" text="Chips" />
                                                        <Label styleClass="pill-badge" text="Pop-Corn" />
                                                        <Label styleClass="pill-badge" text="Ice-tea" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </HBox>

                                        <HBox alignment="BOTTOM_RIGHT" spacing="15.0">
                                            <children>
                                                <Button styleClass="action-btn-secondary" text="Modifier ✍">
                                                    <graphic>
                                                        <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                                                    </graphic>
                                                </Button>
                                                <Button styleClass="action-btn-secondary" text="Supprimer 🗑">
                                                    <graphic>
                                                        <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                                                    </graphic>
                                                </Button>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>
</BorderPane>