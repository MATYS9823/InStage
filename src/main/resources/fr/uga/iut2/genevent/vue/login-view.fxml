<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox alignment="TOP_CENTER" prefHeight="720.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="75.0" styleClass="header">
            <children>
                <Button onAction="#allerVersAccueil" styleClass="icon-button">
                    <graphic>
                        <ImageView fitHeight="45.0" preserveRatio="true">
                            <image>
                                <Image url="@logotransparent.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Region HBox.hgrow="ALWAYS" />

                <MenuButton styleClass="icon-button">
                    <graphic>
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" fill="white" scaleX="1.3" scaleY="1.3" />
                    </graphic>
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#newOrganisateurMenuItemAction" text="Créer un compte " />
                        <MenuItem mnemonicParsing="false" onAction="#motdepasseOublierAction" text="Mot de passe oublié " />
                        <MenuItem mnemonicParsing="false" onAction="#quitterMenuBurgerAction" text="Quitter" />
                    </items>
                </MenuButton>
            </children>
        </HBox>

        <VBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
            <children>
                <Label styleClass="text-dark" text="Se connecter">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>

                <VBox maxWidth="400.0" spacing="15.0">
                    <children>
                        <Label styleClass="text-dark" text="ADRESSE E-MAIL">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="loginEmailTextField" onKeyReleased="#validateLoginFields" promptText="bonjour@canva.com" styleClass="input-field" />

                        <Label styleClass="text-dark" text="MOT DE PASSE">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <PasswordField fx:id="loginMdpField" onKeyReleased="#validateLoginFields" promptText="••••••" styleClass="input-field" />
                    </children>
                </VBox>

                <VBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Hyperlink onAction="#motdepasseOublierAction" styleClass="custom-link" text="Mot de passe oublié ?" />

                        <Button fx:id="loginOkButton" disable="true" onAction="#loginAction" prefHeight="45.0" prefWidth="200.0" styleClass="custom-button" text="Connexion">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Button>

                        <Hyperlink onAction="#newOrganisateurMenuItemAction" styleClass="custom-link" text="Pas encore de compte ? Créer un compte" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>