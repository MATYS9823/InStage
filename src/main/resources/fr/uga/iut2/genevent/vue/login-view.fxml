<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.shape.SVGPath?>
<VBox alignment="TOP_CENTER" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #9E9E9E; -fx-padding: 10;">
            <children>
                <Region HBox.hgrow="ALWAYS" />
                <MenuButton style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" fill="white" scaleX="1.3" scaleY="1.3" />
                    </graphic>
                    <items>
                        <MenuItem mnemonicParsing="false" text="Se connecter" />
                        <MenuItem mnemonicParsing="false" text="Quitter" />
                    </items>
                </MenuButton>
            </children>
        </HBox>

        <VBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Se connecter" textFill="#9a9a9a">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>

                <VBox maxWidth="400.0" spacing="15.0">
                    <children>
                        <Label text="ADRESSE E-MAIL" textFill="#9a9a9a" />
                        <TextField fx:id="loginEmailTextField" onKeyReleased="#validateLoginFields" promptText="bonjour@canva.com" style="-fx-background-color: #EEEEEE; -fx-background-radius: 10; -fx-padding: 10;" />

                        <Label text="MOT DE PASSE" textFill="#9a9a9a" />
                        <PasswordField fx:id="loginMdpField" onKeyReleased="#validateLoginFields" promptText="••••••" style="-fx-background-color: #EEEEEE; -fx-background-radius: 10; -fx-padding: 10;" />
                    </children>
                </VBox>

                <VBox alignment="CENTER" spacing="15.0">
                    <children>
                  <Hyperlink onAction="#motdepasseOublierAction" text="Mot de passe oublié ?" textFill="#9a9a9a" />
                        <Button fx:id="loginOkButton" disable="true" onAction="#loginAction" prefWidth="200.0" style="-fx-background-color: #333333; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 12; -fx-cursor: hand;" text="Connexion">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Hyperlink onAction="#newOrganisateurMenuItemAction" text="Pas encore de compte ? Créer un compte" textFill="#9a9a9a" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>
