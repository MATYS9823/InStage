<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>


<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" style="-fx-background-color: white;">


    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #9E9E9E; -fx-padding: 10 20 10 20;">
            <children>
                <Button style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="40.0" preserveRatio="true">
                            <image>
                                <Image url="@logo.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Button style="-fx-background-color: #757575; -fx-background-radius: 50; -fx-min-width: 40; -fx-min-height: 40; -fx-text-fill: white; -fx-cursor: hand;" text="👤" />
            </children>
        </HBox>
    </top>


    <center>
        <StackPane>
            <children>


                <BorderPane style="-fx-background-color: white;">
                    <top>
                        <VBox>
                            <children>
                                <BorderPane style="-fx-padding: 10 20 10 20; -fx-background-color: white;">
                                    <left>
                                        <Button onAction="#toggleMenu" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 28; -fx-padding: 0;" text="☰" textFill="#B0B0B0" BorderPane.alignment="CENTER" />
                                    </left>
                                    <center>
                                        <Label text="Gérer vos concerts username" textFill="#333333" BorderPane.alignment="CENTER">
                                            <font>
                                                <Font name="System Bold" size="28.0" />
                                            </font>
                                        </Label>
                                    </center>
                                    <right>
                                        <Button onAction="#newConcertMenuItemAction" prefHeight="45.0" prefWidth="140.0" style="-fx-background-color: #BDBDBD; -fx-background-radius: 30; -fx-text-fill: #333333; -fx-cursor: hand;" text="Nouveau +" BorderPane.alignment="CENTER">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Button>
                                    </right>
                                </BorderPane>
                                <Separator prefWidth="200.0" style="-fx-background-color: #D0D0D0;" />
                            </children>
                        </VBox>
                    </top>


                    <center>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 20 40 20 40;">
                            <content>
                                <TilePane hgap="30.0" prefColumns="3" style="-fx-background-color: white;" vgap="30.0">
                                    <children>
                                        <VBox prefHeight="180.0" prefWidth="350.0" spacing="10.0" style="-fx-background-color: #E0E0E0; -fx-background-radius: 25; -fx-padding: 20;">
                                            <children>
                                                <Label text="Goosebump_France" textFill="#333333">
                                                    <font>
                                                        <Font name="System Bold" size="18.0" />
                                                    </font>
                                                </Label>
                                                <HBox spacing="10.0">
                                                    <children>
                                                        <Label text="📍 Accor Arena" textFill="#666666" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label text="Travis Scott" textFill="#666666" />
                                                    </children>
                                                </HBox>
                                                <Region VBox.vgrow="ALWAYS" />
                                                <Label alignment="CENTER" maxWidth="Infinity" text="20/07/2027" textFill="#333333">
                                                    <font>
                                                        <Font name="System Bold" size="14.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </TilePane>
                            </content>
                        </ScrollPane>
                    </center>
                </BorderPane>


                <Region fx:id="scrim" onMouseClicked="#toggleMenu" style="-fx-background-color: rgba(0,0,0,0.3);" visible="false" />


                <HBox fx:id="sideMenu" maxWidth="300.0" visible="false" StackPane.alignment="CENTER_LEFT">
                    <children>
                        <VBox prefWidth="300.0" spacing="20.0" style="-fx-background-color: #444444; -fx-padding: 20;">
                            <children>
                                <HBox alignment="TOP_RIGHT">
                                    <children>
                                        <Button onAction="#toggleMenu" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 20; -fx-cursor: hand;" text="✖" />
                                    </children>
                                </HBox>
                                <VBox spacing="10.0">
                                    <children>
                                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#allerVersAccueil" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="🏠  Accueil">
                                            <font>
                                                <Font size="18.0" />
                                            </font>
                                        </Button>
                                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="🔍  Rechercher une salle">
                                            <font>
                                                <Font size="18.0" />
                                            </font>
                                        </Button>
                                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: white; -fx-background-radius: 20; -fx-text-fill: black; -fx-cursor: hand;" text="🔘  Mes concerts">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>


            </children>
        </StackPane>
    </center>
</BorderPane>

