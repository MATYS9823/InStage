<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>

<HBox fx:id="rootHBox" alignment="CENTER_LEFT" prefWidth="360.0"
      style="-fx-border-color: #cccccc; -fx-border-width: 1; -fx-background-color: white; -fx-padding: 15; -fx-border-radius: 5;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>

        <Label style="-fx-font-size: 28px;" text="📍">
            <HBox.margin><Insets right="15.0" /></HBox.margin>
        </Label>

        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="lblNom" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="..." />
                <Label fx:id="lblAdresse" style="-fx-text-fill: #666;" text="..." />
                <Label fx:id="lblCapacite" text="..." />
                <Label fx:id="lblTarif" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" text="..." />
            </children>
        </VBox>

        <VBox alignment="CENTER" spacing="5.0">
            <children>
                <Button fx:id="btnSelectionner" mnemonicParsing="false"
                        style="-fx-background-color: black; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 10 5 10;"
                        text="SÉLECTIONNER" />
            </children>
        </VBox>
    </children>
</HBox>