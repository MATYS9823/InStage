<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="75.0" style="-fx-background-color: #8E8E8E; -fx-padding: 15 40 15 40;">
            <children>
                <Button style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-padding: 5 25 5 25; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="30.0" preserveRatio="true">
                            <image>
                                <Image url="@logo.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#connexionMenuItemAction" style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <Label text="👤" textFill="WHITE">
                            <font>
                                <Font size="28.0" />
                            </font>
                        </Label>
                    </graphic>
                </Button>
            </children>
        </HBox>

        <VBox alignment="TOP_CENTER" spacing="50.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="40.0" left="80.0" right="80.0" top="60.0" />
            </padding>
            <children>

                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label fx:id="welcomeLabel" text="Bienvenue username" textFill="#000000">
                            <font>
                                <Font name="System" size="36.0" />
                            </font>
                        </Label>
                        <Label text="que voulez vous faire aujourd'hui ?" textFill="#000000">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="40.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#allerVersMesConcerts" prefHeight="200.0" prefWidth="320.0" style="-fx-background-color: #B5B5B5; -fx-background-radius: 35; -fx-cursor: hand;" text="Mes concerts" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#newConcertMenuItemAction" prefHeight="200.0" prefWidth="320.0" style="-fx-background-color: #B5B5B5; -fx-background-radius: 35; -fx-cursor: hand;" text="Créer un concert" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false"  onAction="#allerVersRechercheSalles" prefHeight="200.0" prefWidth="320.0" style="-fx-background-color: #B5B5B5; -fx-background-radius: 35; -fx-cursor: hand;" text="Rechercher une salle" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <VBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label text="Reprendre là où vous vous étiez arrêté :" textFill="#333333">
                            <font>
                                <Font size="18.0" />
                            </font>
                            <VBox.margin>
                                <Insets left="10.0" />
                            </VBox.margin>
                        </Label>
                        <Button maxWidth="Infinity" prefHeight="140.0" style="-fx-background-color: #EAEAEA; -fx-background-radius: 35; -fx-cursor: hand;" text="Dernier concert consulté" textFill="#999999">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets top="30.0" />
                    </VBox.margin>
                </VBox>

            </children>
        </VBox>
    </children>
</VBox>
