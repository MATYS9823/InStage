<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>

<AnchorPane prefHeight="750.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <BorderPane style="-fx-background-color: white;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <top>
            <VBox>
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: #909090; -fx-padding: 10 20 10 20;">
                    <Button style="-fx-background-color: white; -fx-text-fill: black; -fx-background-radius: 3; -fx-padding: 5 30 5 30;" text="Logo" />
                    <Region HBox.hgrow="ALWAYS" />
                    <MenuButton style="-fx-background-color: transparent; -fx-cursor: hand;">
                        <graphic>
                            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" fill="white" scaleX="1.3" scaleY="1.3" />
                        </graphic>
                        <items>
                            <MenuItem mnemonicParsing="false" onAction="#connexionMenuItemActionNU" text="Se déconnecter" />
                            <MenuItem mnemonicParsing="false" onAction="#quitterMenuBurgerAction" text="Quitter" />
                        </items>
                    </MenuButton>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 15 20 0 20;">
                    <Label onMouseClicked="#toggleMenuBuvette" style="-fx-font-size: 32px; -fx-text-fill: #A0A0A0; -fx-font-weight: bold; -fx-cursor: hand;" text="☰" />
                </HBox>
            </VBox>
        </top>

        <center>
            <StackPane BorderPane.alignment="CENTER">

                <VBox alignment="CENTER" maxWidth="500.0" spacing="12.0">
                    <StackPane.margin>
                        <Insets bottom="20.0" top="10.0" />
                    </StackPane.margin>

                    <Label alignment="CENTER" style="-fx-font-size: 32px; -fx-text-fill: #555555; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: bold;" text="Créer une nouvelle buvette" textAlignment="CENTER" wrapText="true">
                        <VBox.margin>
                            <Insets bottom="15.0" />
                        </VBox.margin>
                    </Label>

                    <VBox spacing="5.0">
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 14px; -fx-font-weight: bold;" text="Nom">
                            <VBox.margin>
                                <Insets left="15.0" />
                            </VBox.margin>
                        </Label>
                        <TextField fx:id="tfNomBuvette" prefHeight="40.0" style="-fx-background-color: #F0F0F0; -fx-background-radius: 25; -fx-padding: 0 20 0 20; -fx-font-size: 14px;" />
                    </VBox>

                    <VBox spacing="5.0">
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 14px; -fx-font-weight: bold;" text="Localisation">
                            <VBox.margin>
                                <Insets left="15.0" />
                            </VBox.margin>
                        </Label>
                        <TextField fx:id="tfLocalisationBuvette" prefHeight="40.0" style="-fx-background-color: #F0F0F0; -fx-background-radius: 25; -fx-padding: 0 20 0 20; -fx-font-size: 14px;" />
                    </VBox>

                    <Button maxWidth="Infinity" onAction="#createNewBuvetteAction" prefHeight="45.0" style="-fx-background-color: #0078D4; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand;" text="Créer">
                        <VBox.margin>
                            <Insets top="15.0" />
                        </VBox.margin>
                    </Button>
                </VBox>

                <Region fx:id="scrimBuvette" onMouseClicked="#toggleMenuBuvette" style="-fx-background-color: rgba(0,0,0,0.4);" visible="false" />

                <VBox fx:id="sideMenuBuvette" maxWidth="300.0" style="-fx-background-color: #555555;" visible="false" StackPane.alignment="CENTER_LEFT">
                    <HBox alignment="CENTER_RIGHT" style="-fx-padding: 15 20 20 20;">
                        <Label onMouseClicked="#toggleMenuBuvette" style="-fx-font-size: 28px; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="×" />
                    </HBox>

                    <VBox spacing="10.0" style="-fx-padding: 10 0 20 0;">
                        <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersAccueil" spacing="15.0" style="-fx-padding: 10 20 10 30; -fx-cursor: hand;">
                            <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="🏠 Vos concerts" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersBuvette" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 0 25 25 0; -fx-padding: 10 20 10 30; -fx-cursor: hand;">
                            <Label style="-fx-text-fill: black; -fx-font-size: 16px; -fx-font-weight: bold;" text="🍸 Buvette" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersMerch" spacing="15.0" style="-fx-padding: 10 20 10 30; -fx-cursor: hand;">
                            <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="👕 Merch" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersStaff" spacing="15.0" style="-fx-padding: 10 20 10 30; -fx-cursor: hand;">
                            <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="👤 Staff" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersMateriel" spacing="15.0" style="-fx-padding: 10 20 10 30; -fx-cursor: hand;">
                            <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="📦 Matériel" />
                        </HBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />
                    <VBox alignment="CENTER" style="-fx-padding: 20;">
                        <Button style="-fx-background-color: white; -fx-text-fill: black; -fx-background-radius: 20; -fx-padding: 10 20;" text="Goosebump_France" />
                    </VBox>
                </VBox>

            </StackPane>
        </center>

    </BorderPane>
</AnchorPane>
