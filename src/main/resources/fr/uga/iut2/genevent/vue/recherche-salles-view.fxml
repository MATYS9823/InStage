<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.web.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:controller="fr.uga.iut2.genevent.vue.RechercheSallesController" prefHeight="800.0" prefWidth="1200.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="75.0" styleClass="header" BorderPane.alignment="CENTER">
            <children>
                <Button onAction="#allerVersAccueil" styleClass="icon-button">
                    <graphic>
                        <ImageView fitHeight="90.0" preserveRatio="true">
                            <image>
                                <Image url="@logotransparent.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS" />

                <MenuButton styleClass="icon-button">
                    <graphic>
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" fill="white" scaleX="1.3" scaleY="1.3" />
                    </graphic>
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#connexionMenuItemActionNU" text="Se déconnecter" />
                        <MenuItem mnemonicParsing="false" onAction="#quitterMenuBurgerAction" text="Quitter" />
                    </items>
                </MenuButton>
            </children>
        </HBox>
    </top>

    <center>
        <StackPane BorderPane.alignment="CENTER">
            <children>
                <BorderPane>
                    <left>
                        <VBox prefWidth="420.0" spacing="20.0" style="-fx-background-color: #FAFAFA; -fx-border-color: #DDDDDD; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label onMouseClicked="#toggleMenuD" style="-fx-font-size: 28px; -fx-text-fill: #A0A0A0; -fx-cursor: hand;" text="☰" />

                                <GridPane hgap="15.0" vgap="20.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #333333;" text="LIEU 📍" />
                                                <TextField fx:id="filtreLieu" promptText="Ex: Rue des Arts" style="-fx-background-radius: 0; -fx-border-color: #A0A0A0;" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" GridPane.columnIndex="1">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #333333;" text="CAPACITÉ 👤" />
                                                <TextField fx:id="filtreCapacite" promptText="Ex: 10000" style="-fx-background-radius: 0; -fx-border-color: #A0A0A0;" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" GridPane.rowIndex="1">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #333333;" text="TARIF HORAIRE" />
                                                <TextField fx:id="filtreTarif" promptText="Ex: 1200" style="-fx-background-radius: 0; -fx-border-color: #A0A0A0;" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" GridPane.rowIndex="2">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #333333;" text="DATE DÉBUT" />
                                                <DatePicker fx:id="date_debut" maxWidth="Infinity" style="-fx-background-radius: 0; -fx-border-color: #A0A0A0;" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #333333;" text="DATE FIN" />
                                                <DatePicker fx:id="date_fin" maxWidth="Infinity" style="-fx-background-radius: 0; -fx-border-color: #A0A0A0;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#appliquerFiltres" style="-fx-background-color: #333333; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;" text="RECHERCHER UNE SALLE" />

                                <ListView fx:id="listViewSalles" style="-fx-background-color: #FAFAFA; -fx-control-inner-background: #FAFAFA;" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                    </left>
                    <center>
                        <WebView fx:id="webViewCarte" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
                    </center>
                </BorderPane>

                <Region fx:id="scrim" onMouseClicked="#toggleMenuD" style="-fx-background-color: rgba(0,0,0,0.3);" visible="false" />

                <HBox fx:id="sideMenuD" maxWidth="300.0" visible="false" StackPane.alignment="CENTER_LEFT">
                    <children>
                        <VBox prefWidth="300.0" style="-fx-background-color: #444444;">
                            <children>
                                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 15 20 20 20;">
                                    <children>
                                        <Label onMouseClicked="#toggleMenuD" style="-fx-font-size: 28px; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="×" />
                                    </children>
                                </HBox>
                                <VBox spacing="10.0">
                                    <children>
                                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#allerVersAccueil" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10 20 10 30;" text="🏠  Accueil">
                                            <font>
                                                <Font size="16.0" />
                                            </font>
                                        </Button>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Region minWidth="4.0" prefHeight="35.0" style="-fx-background-color: white; -fx-background-radius: 3;">
                                                    <HBox.margin>
                                                        <Insets left="10.0" right="6.0" />
                                                    </HBox.margin>
                                                </Region>
                                                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: white; -fx-background-radius: 20; -fx-text-fill: black; -fx-cursor: default; -fx-padding: 10 20 10 10;" text="🔍  Rechercher une salle" HBox.hgrow="ALWAYS">
                                                    <HBox.margin>
                                                        <Insets right="40.0" />
                                                    </HBox.margin>
                                                    <font>
                                                        <Font name="System Bold" size="16.0" />
                                                    </font>
                                                </Button>
                                            </children>
                                        </HBox>
                                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#allerVersMesConcerts" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10 20 10 30;" text=" Mes concerts">
                                            <font>
                                                <Font size="16.0" />
                                            </font>
                                            <graphic>
                                                <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
                                            </graphic>
                                        </Button>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </StackPane>
    </center>
</BorderPane>