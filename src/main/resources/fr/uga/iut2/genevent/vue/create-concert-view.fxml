<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="900.0" styleClass="root-pane" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <top>
            <HBox alignment="CENTER_LEFT" prefHeight="75.0" styleClass="header">
                <children>
                    <Button onAction="#allerVersAccueil" styleClass="icon-button">
                        <graphic>
                            <ImageView fitHeight="45.0" preserveRatio="true">
                                <image>
                                    <Image url="@Logo.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Region HBox.hgrow="ALWAYS" />

                    <MenuButton style="-fx-background-color: transparent; -fx-cursor: hand;">
                        <graphic>
                            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" fill="white" scaleX="1.3" scaleY="1.3" />
                        </graphic>
                        <items>
                            <MenuItem mnemonicParsing="false" onAction="#connexionMenuItemAction" text="Se déconnecter" />
                            <MenuItem mnemonicParsing="false" onAction="#quitterMenuBurgerAction" text="Quitter" />
                        </items>
                    </MenuButton>
                </children>
            </HBox>
        </top>

        <center>
            <StackPane BorderPane.alignment="CENTER">

                <BorderPane>
                    <top>
                        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 15 20 0 20;">
                            <Label onMouseClicked="#toggleMenuD" styleClass="text-dark" style="-fx-cursor: hand;" text="☰">
                                <font>
                                    <Font name="System Bold" size="32.0" />
                                </font>
                            </Label>
                        </HBox>
                    </top>
                    <center>
                        <VBox alignment="CENTER" maxWidth="500.0" spacing="12.0">
                            <BorderPane.margin>
                                <Insets bottom="20.0" top="10.0" />
                            </BorderPane.margin>

                            <Label alignment="CENTER" styleClass="text-dark" text="Créer un nouveau concert" textAlignment="CENTER" wrapText="true">
                                <font>
                                    <Font name="System Bold" size="32.0" />
                                </font>
                                <VBox.margin>
                                    <Insets bottom="15.0" />
                                </VBox.margin>
                            </Label>

                            <VBox spacing="5.0">
                                <Label styleClass="text-dark" text="Nom">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets left="15.0" />
                                    </VBox.margin>
                                </Label>
                                <TextField fx:id="tfNomconcert" prefHeight="45.0" styleClass="input-field" />
                            </VBox>

                            <VBox spacing="5.0">
                                <Label styleClass="text-dark" text="Lieu">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets left="15.0" />
                                    </VBox.margin>
                                </Label>
                                <TextField fx:id="tflieuconcert" prefHeight="45.0" styleClass="input-field" />
                            </VBox>

                            <VBox spacing="5.0">
                                <Label styleClass="text-dark" text="Date de début">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets left="15.0" />
                                    </VBox.margin>
                                </Label>
                                <DatePicker fx:id="dpDateDebut" maxWidth="Infinity" prefHeight="45.0" styleClass="date-field" />
                            </VBox>

                            <VBox spacing="5.0">
                                <Label styleClass="text-dark" text="Date de fin">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets left="15.0" />
                                    </VBox.margin>
                                </Label>
                                <DatePicker fx:id="dpDateFin" maxWidth="Infinity" prefHeight="45.0" styleClass="date-field" />
                            </VBox>

                            <VBox spacing="5.0">
                                <Label styleClass="text-dark" text="Artiste">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets left="15.0" />
                                    </VBox.margin>
                                </Label>
                                <TextField fx:id="tfArtiste" prefHeight="45.0" styleClass="input-field" />
                            </VBox>

                            <Button maxWidth="Infinity" onAction="#createNewConcertAction" prefHeight="50.0" styleClass="custom-button" text="Créer">
                                <font>
                                    <Font name="System Bold" size="18.0" />
                                </font>
                                <VBox.margin>
                                    <Insets top="15.0" />
                                </VBox.margin>
                            </Button>
                        </VBox>
                    </center>
                </BorderPane>

                <Region fx:id="scrim" onMouseClicked="#toggleMenuD" style="-fx-background-color: rgba(0,0,0,0.4);" visible="false" />

                <VBox fx:id="sideMenuD" maxWidth="300.0" styleClass="sidebar" visible="false" StackPane.alignment="CENTER_LEFT">
                    <HBox alignment="CENTER_RIGHT" style="-fx-padding: 15 20 20 20;">
                        <Label onMouseClicked="#toggleMenuD" style="-fx-text-fill: white; -fx-cursor: hand;" text="×">
                            <font>
                                <Font name="System Bold" size="36.0" />
                            </font>
                        </Label>
                    </HBox>

                    <VBox spacing="20.0" style="-fx-padding: 20 20 20 40;">

                        <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersAccueil" spacing="15.0" style="-fx-cursor: hand;">
                            <SVGPath content="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
                            <Label style="-fx-text-fill: white;" text="Accueil">
                                <font>
                                    <Font name="System Bold" size="18.0" />
                                </font>
                            </Label>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersRechercheSalles" spacing="15.0" style="-fx-cursor: hand;">
                            <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
                            <Label style="-fx-text-fill: white;" text="Rechercher une salle">
                                <font>
                                    <Font name="System Bold" size="18.0" />
                                </font>
                            </Label>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" onMouseClicked="#allerVersMesConcerts" spacing="15.0" style="-fx-cursor: hand;">
                            <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
                            <Label style="-fx-text-fill: white;" text="Mes concerts">
                                <font>
                                    <Font name="System Bold" size="18.0" />
                                </font>
                            </Label>
                        </HBox>

                    </VBox>
                </VBox>

            </StackPane>
        </center>

    </BorderPane>
</AnchorPane>