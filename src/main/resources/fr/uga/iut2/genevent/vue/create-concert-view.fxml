<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.control.MenuItem?>

<AnchorPane prefHeight="750.0" prefWidth="900.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <BorderPane style="-fx-background-color: white;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <top>
            <VBox>
                <HBox alignment="CENTER_LEFT" prefHeight="75.0" styleClass="header">
                    <children>
                        <Button onAction="#allerVersAccueil" styleClass="icon-button">
                            <graphic>
                                <ImageView fitHeight="45.0" preserveRatio="true">
                                    <image>
                                        <Image url="@logotransparent.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button styleClass="icon-button">
                            <graphic>
                                <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="white" scaleX="1.5" scaleY="1.5" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <padding>
                        <Insets left="20.0" top="15.0" />
                    </padding>
                    <children>
                        <Label styleClass="text-dark" text="☰">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
            </VBox>
        </top>

        <center>
            <VBox alignment="CENTER" maxWidth="500.0" spacing="12.0" BorderPane.alignment="CENTER">
                <BorderPane.margin>
                    <Insets bottom="20.0" top="10.0" />
                </BorderPane.margin>

                <Label alignment="CENTER" styleClass="text-dark" text="Créer un nouveau concert" textAlignment="CENTER" wrapText="true">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Label>

                <VBox spacing="5.0">
                    <Label styleClass="text-dark" text="Nom">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                        <VBox.margin>
                            <Insets left="15.0" />
                        </VBox.margin>
                    </Label>
                    <TextField fx:id="tfNomconcert" prefHeight="45.0" styleClass="input-field" />
                </VBox>

                <VBox spacing="5.0">
                    <Label styleClass="text-dark" text="Lieu">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                        <VBox.margin>
                            <Insets left="15.0" />
                        </VBox.margin>
                    </Label>
                    <TextField fx:id="tflieuconcert" prefHeight="45.0" styleClass="input-field" />
                </VBox>

                <VBox spacing="5.0">
                    <Label styleClass="text-dark" text="Date de début">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                        <VBox.margin>
                            <Insets left="15.0" />
                        </VBox.margin>
                    </Label>
                    <DatePicker fx:id="dpDateDebut" maxWidth="Infinity" prefHeight="45.0" styleClass="date-field" />
                </VBox>

                <VBox spacing="5.0">
                    <Label styleClass="text-dark" text="Date de fin">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                        <VBox.margin>
                            <Insets left="15.0" />
                        </VBox.margin>
                    </Label>
                    <DatePicker fx:id="dpDateFin" maxWidth="Infinity" prefHeight="45.0" styleClass="date-field" />
                </VBox>

                <VBox spacing="5.0">
                    <Label styleClass="text-dark" text="Artiste">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                        <VBox.margin>
                            <Insets left="15.0" />
                        </VBox.margin>
                    </Label>
                    <TextField fx:id="tfArtiste" prefHeight="45.0" styleClass="input-field" />
                </VBox>

                <Button maxWidth="Infinity" onAction="#createNewConcertAction" prefHeight="50.0" styleClass="custom-button" text="Créer">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="15.0" />
                    </VBox.margin>
                </Button>
            </VBox>
        </center>

    </BorderPane>
</AnchorPane>
