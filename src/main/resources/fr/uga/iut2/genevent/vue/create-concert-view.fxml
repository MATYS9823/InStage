<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <BorderPane style="-fx-background-color: white;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <top>
            <VBox>
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: #909090; -fx-padding: 10 20 10 20;">
                    <Button style="-fx-background-color: white; -fx-text-fill: black; -fx-background-radius: 3; -fx-padding: 5 30 5 30;" text="Logo" />

                    <Region HBox.hgrow="ALWAYS" />

                    <StackPane prefHeight="35.0" prefWidth="35.0" style="-fx-border-color: white; -fx-border-width: 1.5; -fx-border-radius: 50%; -fx-padding: 5;">
                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
                    </StackPane>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 15 20 0 20;">
                    <Label style="-fx-font-size: 32px; -fx-text-fill: #A0A0A0; -fx-font-weight: bold;" text="☰" />
                </HBox>
            </VBox>
        </top>

        <center>
            <VBox alignment="CENTER" maxWidth="400.0" spacing="15.0">
                <BorderPane.margin>
                    <Insets bottom="80.0" top="40.0" />
                </BorderPane.margin>

                <Label style="-fx-font-size: 36px; -fx-text-fill: #555555; -fx-font-family: 'Segoe UI', sans-serif;" text="Créer un nouveau&#10;concert" textAlignment="CENTER">
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Label>

                <VBox spacing="5.0">
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 14px;" text="Nom">
                        <VBox.margin>
                            <Insets left="15.0" />
                        </VBox.margin>
                    </Label>
                    <TextField fx:id="tfNom" prefHeight="45.0" style="-fx-background-color: #F0F0F0; -fx-background-radius: 25; -fx-padding: 0 20 0 20; -fx-font-size: 14px;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 14px;" text="Date">
                        <VBox.margin>
                            <Insets left="15.0" />
                        </VBox.margin>
                    </Label>
                    <TextField fx:id="tfDate" prefHeight="45.0" style="-fx-background-color: #F0F0F0; -fx-background-radius: 25; -fx-padding: 0 20 0 20; -fx-font-size: 14px;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 14px;" text="Salle">
                        <VBox.margin>
                            <Insets left="15.0" />
                        </VBox.margin>
                    </Label>
                    <TextField fx:id="tfSalle" prefHeight="45.0" style="-fx-background-color: #F0F0F0; -fx-background-radius: 25; -fx-padding: 0 20 0 20; -fx-font-size: 14px;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 14px;" text="Artiste">
                        <VBox.margin>
                            <Insets left="15.0" />
                        </VBox.margin>
                    </Label>
                    <TextField fx:id="tfArtiste" prefHeight="45.0" style="-fx-background-color: #F0F0F0; -fx-background-radius: 25; -fx-padding: 0 20 0 20; -fx-font-size: 14px;" />
                </VBox>

                <Button maxWidth="Infinity" onAction="#handleCreerConcert" prefHeight="45.0" style="-fx-background-color: #CCCCCC; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 25;" text="Créer">
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </Button>
            </VBox>
        </center>

    </BorderPane>
</AnchorPane>
